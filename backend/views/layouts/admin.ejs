<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      HelpSync Admin - <%= typeof title !== 'undefined' ? title : 'Dashboard' %>
    </title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css"
    />
  </head>
  <body>
    <nav class="navbar navbar-dark bg-primary">
      <div class="container-fluid">
        <a class="navbar-brand" href="/admin/dashboard">
          <i class="bi bi-chat-dots-fill"></i> HelpSync Admin
        </a>
        <div class="d-flex align-items-center text-white">
          <span class="me-3"><%= adminEmail %></span>
          <a href="/admin/logout" class="btn btn-outline-light btn-sm"
            >Logout</a
          >
        </div>
      </div>
    </nav>

    <div class="container-fluid">
      <div class="row">
        <nav
          class="col-md-2 col-lg-2 d-md-block bg-light sidebar"
          style="min-height: calc(100vh - 56px)"
        >
          <div class="position-sticky pt-3">
            <ul class="nav flex-column">
              <li class="nav-item">
                <a class="nav-link" href="/admin/dashboard">
                  <i class="bi bi-speedometer2"></i> Dashboard
                </a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/admin/conversations">
                  <i class="bi bi-chat-left-text"></i> Conversations
                </a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/admin/knowledge-base">
                  <i class="bi bi-book"></i> Knowledge Base
                </a>
              </li>
            </ul>
          </div>
        </nav>

        <main class="col-md-10 ms-sm-auto col-lg-10 px-md-4">
          <div class="py-4"><%- body %></div>
        </main>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
