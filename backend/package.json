    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "seed": "ts-node prisma/seed.ts",
    "validate-env": "ts-node scripts/validate-env.ts",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
