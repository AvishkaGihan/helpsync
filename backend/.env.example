# Server Configuration
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/helpsync_db"

# JWT Authentication (generate a strong random secret)
JWT_SECRET="your-super-secret-jwt-key-change-this-to-something-random-at-least-32-chars"

# Google Gemini AI
GEMINI_API_KEY="your-gemini-api-key-from-ai-google-dev"

# Stripe (Test Mode)
STRIPE_SECRET_KEY="sk_test_your-stripe-test-secret-key"

# Twilio
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"
ADMIN_PHONE_NUMBER="+1987654321"

# CORS
MOBILE_APP_URL="http://localhost:*"